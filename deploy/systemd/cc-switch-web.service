[Unit]
Description=cc-switch Web Server
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cc-switch-web
Restart=on-failure
RestartSec=3
# Graceful stop restores the live CLI configs taken over by the routing proxy
# (removes PROXY_MANAGED placeholders). Must comfortably exceed the proxy stop
# timeout (5s) plus the live-config restore writes; only after this window does
# systemd escalate to SIGKILL (which would leave placeholders until the next
# boot's crash recovery).
TimeoutStopSec=30
Environment=HOST=0.0.0.0
Environment=PORT=3010
Environment=ENABLE_HSTS=false
# Audit fix C2: the Web API exposes provider secrets, SQLite import/export, and
# proxy takeover. A non-loopback bind (HOST=0.0.0.0, for Tailscale/LAN) now REQUIRES
# HTTP Basic Auth — the server refuses to start otherwise. Set a STRONG password
# below (e.g. `openssl rand -base64 24`). The browser prompts for it once; the SPA's
# /api calls then carry it automatically. Username defaults to `cc-switch`.
Environment=CC_SWITCH_WEB_AUTH_USER=cc-switch
# REQUIRED for HOST=0.0.0.0 — uncomment and set before enabling the service:
# Environment=CC_SWITCH_WEB_AUTH_PASSWORD=CHANGE_ME_to_a_strong_password
Environment=CC_SWITCH_DATA_DIR=%h/.cc-switch
Environment=CC_SWITCH_WEB_DIST_DIR=%h/.local/share/cc-switch-web/dist-web
# Privacy-by-default: full request/response bodies (prompts + model outputs) are
# logged only at `cc_switch=debug`. Keep `info` so those bodies are NOT written to
# the systemd journal in plaintext. To troubleshoot, an operator can TEMPORARILY
# set `RUST_LOG=info,cc_switch=debug` (then revert) to capture verbose proxy traffic.
Environment=RUST_LOG=info
WorkingDirectory=%h

[Install]
WantedBy=default.target
